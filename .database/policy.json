{
  "version": 1,
  "migrationDirectory": "scripts/mysql_migrations",
  "versionedPattern": "^V(?P<version>[0-9][0-9._-]*)__[A-Za-z0-9][A-Za-z0-9_-]*\\.sql$",
  "repeatablePattern": "^R__[A-Za-z0-9][A-Za-z0-9_-]*\\.sql$",
  "allowRepeatable": false,
  "destructivePatterns": [
    "\\bDROP\\s+(TABLE|COLUMN|SCHEMA|DATABASE)\\b",
    "\\bTRUNCATE\\s+TABLE\\b",
    "\\bALTER\\s+TABLE\\b.*\\bDROP\\b"
  ],
  "riskAcceptanceMarker": "-- risk-accepted:"
}
